# ═══════════════════════════════════════════════════════════════════════════
# AutoMark AI — unified environment
# Copy to .env and fill in. One file for all three modules.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# ONE database for CRM, Campaigns, and Analytics. Requires the pgvector
# extension (the pgvector/pgvector:pg16 image has it built in).
# The campaign module's old POSTGRES_URL is still accepted, but only when
# DATABASE_URL is left at its default — an explicit DATABASE_URL always wins.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automark
DB_ECHO=false

# ── Auth (app-wide identity — CHANGE THIS IN PRODUCTION) ───────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# ── Gemini / Google AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TTS_MODEL=

# ── LangSmith tracing (optional) ───────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=automark

# ── Application ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console
DEBUG=false
# Comma-separated allowed origins. Ignored when DEBUG=true (which allows "*").
CORS_ORIGINS=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════
# CRM module
# ═══════════════════════════════════════════════════════════════════════════

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

MESSENGER_VERIFY_TOKEN=
MESSENGER_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ID=

FB_COMMENTS_VERIFY_TOKEN=
FB_COMMENTS_ACCESS_TOKEN=
FB_COMMENTS_APP_SECRET=
FB_COMMENTS_PAGE_ID=

VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# RAG
RERANKER_BACKEND=gemini
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
EMBEDDING_DIM=768
# Defaults to src/crm/knowledge_base; override for Docker.
# KNOWLEDGE_BASE_PATH=

# Memory
MAX_CONVERSATION_HISTORY=20
SUMMARIZATION_MESSAGE_THRESHOLD=20
MAX_AGENT_ITERATIONS=6

# Handoff escalation email (Gmail app password OR Resend)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=
RESEND_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# Campaigns module
# ═══════════════════════════════════════════════════════════════════════════

# All text generation runs on Gemini (GEMINI_API_KEY above). LLM_PROVIDER and
# GROQ_API_KEY are no longer read — delete them from an older .env.

# Meta Ads. Keep META_SIMULATION_MODE=true until you intend to spend money.
META_SIMULATION_MODE=true
META_ACCESS_TOKEN=
# Required when META_SIMULATION_MODE=false — FacebookAdsApi.init() needs it,
# and it must pair with META_APP_SECRET.
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
MAKE_ORGANIC_POST=false
MAKE_SPONSORED_PAUSED_AD=true
# Ad Library API (competitor research). Falls back to META_ACCESS_TOKEN.
META_AD_LIBRARY_TOKEN=

ENABLE_FOLLOW_UPS=true
MIN_QUESTIONS=3
MAX_QUESTIONS=6
MAX_REGENERATIONS_ALLOWED=3
NUM_GENERATED_IMAGES=4
ENABLE_WEB_SEARCH=false
AGENT_LOGGING=false
# Hour (UTC 0-23) for the daily campaign diagnosis. Ignored in simulation mode.
LIFECYCLE_DIAGNOSIS_HOUR=9


# ═══════════════════════════════════════════════════════════════════════════
# Analytics module
# ═══════════════════════════════════════════════════════════════════════════

# Defaults to <repo>/uploads
# UPLOAD_DIR=
MAX_UPLOAD_MB=200
ANALYTICS_ROW_SAMPLE=10000


# ═══════════════════════════════════════════════════════════════════════════
# Frontend (built into the "web" container at startup)
# ═══════════════════════════════════════════════════════════════════════════
# Must be reachable from the BROWSER, not from inside the Docker network —
# so this stays http://localhost:8000, not http://api:8000.
NEXT_PUBLIC_API_BASE=http://localhost:8000


# ═══════════════════════════════════════════════════════════════════════════
# Docker Compose overrides (this file only — not read by local, non-Docker
# runs, which configure the database entirely through DATABASE_URL above)
# ═══════════════════════════════════════════════════════════════════════════
# "db" service credentials; also used to build DATABASE_URL for the api/
# analytics containers (which reach Postgres at host "db", not localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automark
