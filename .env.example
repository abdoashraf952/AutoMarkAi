# ─────────────────────────────────────────────────────────────────────────────
# AutoMark AI — Unified Environment Variables
# Copy to .env and fill in every value before starting.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared: Database (PostgreSQL + pgvector) ──────────────────────────────────
# Both CRM and Analytics connect to this single database.
# For Docker: host is "db". For local dev: host is "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automark
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automark
DB_USER=postgres
DB_PASSWORD=postgres

# ── Shared: Gemini API ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Shared: LangSmith tracing (optional — leave blank to disable) ─────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=automark-ai

# ─────────────────────────────────────────────────────────────────────────────
# CRM-SPECIFIC SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# ── CRM: Gemini models ────────────────────────────────────────────────────────
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── CRM: HubSpot ─────────────────────────────────────────────────────────────
# Get from: HubSpot → Settings → Integrations → Private Apps → Create
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# ── CRM: Meta Graph API — Messenger ──────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App
MESSENGER_VERIFY_TOKEN=
MESSENGER_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ID=

# ── CRM: Meta Graph API — Facebook Page Comments ─────────────────────────────
FB_COMMENTS_VERIFY_TOKEN=
FB_COMMENTS_ACCESS_TOKEN=
FB_COMMENTS_APP_SECRET=
FB_COMMENTS_PAGE_ID=

# ── CRM: Vapi Voice ───────────────────────────────────────────────────────────
# Get from: https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ── CRM: RAG ─────────────────────────────────────────────────────────────────
RERANKER_BACKEND=gemini
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
KNOWLEDGE_BASE_PATH=./knowledge_base

# ── CRM: Conversation memory ──────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=20
SUMMARIZATION_MESSAGE_THRESHOLD=20

# ── CRM: Application ──────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=False
MAX_AGENT_ITERATIONS=6

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS-SPECIFIC SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# ── Analytics: File uploads ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── Analytics: SQL source limits (optional) ───────────────────────────────────
SQL_SOURCE_MAX_ROWS=100000
SQL_SOURCE_TIMEOUT_MS=30000
