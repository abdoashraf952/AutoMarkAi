# ==============================================================================
# AutoMark AI — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control!

# --- LLM Provider ------------------------------------------------------------
# Which provider powers all TEXT LLM calls: "gemini" or "groq".
#   gemini → model "gemini-2.5-flash"   (default)
#   groq   → model "openai/gpt-oss-120b"
# Image UNDERSTANDING always uses Gemini (only multimodal provider); image
# GENERATION always uses the Gemini image model.
LLM_PROVIDER=gemini

# --- LLM API Keys -----------------------------------------------------------
# Groq: used for text generation when LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini: text (when LLM_PROVIDER=gemini), image analysis, and image generation.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Meta Marketing API (only needed when META_SIMULATION_MODE=false) --------
# Set to "true" for demo/development mode (no real API calls, fake responses)
# Set to "false" to use the live Meta Marketing API
META_SIMULATION_MODE=true

# Agent Logging: set to "true" to log all agent actions to the console (for debugging)
AGENT_LOGGING=false

# Facebook/Meta access token (user or system token with ads_management permission)
META_ACCESS_TOKEN=your_meta_access_token_here

# Meta App credentials from https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Numeric Ad Account ID (without the "act_" prefix)
META_AD_ACCOUNT_ID=your_ad_account_id_here

# Facebook Page ID (used for ad creatives and organic posts)
META_PAGE_ID=your_page_id_here

# USD → account currency exchange rate (e.g. 49.5 for EGP, 3.67 for AED).
# Leave blank to use the built-in approximation table in meta_client.py.
# META_EXCHANGE_RATE=

# --- Strategist Agent --------------------------------------------------------
# Set to "true" to let the Strategist pull live trends via web search (DuckDuckGo,
# no API key). Leave "false" for fully deterministic, offline strategy generation.
ENABLE_WEB_SEARCH=false

# --- Interview Settings ------------------------------------------------------
# The number of questions is DYNAMIC: the AI asks basic questions first, then
# follow-ups only when they add value. The campaign-target question (always asked
# first) counts as one. These bound the total.
MIN_QUESTIONS=4
MAX_QUESTIONS=10

# --- Image Generation Settings -----------------------------------------------
# Number of ad images to generate per campaign (default: 1)
NUM_GENERATED_IMAGES=1

# Maximum number of image regeneration retries allowed (default: 2)
# After this limit, the user must choose from previously generated images or wait 5 hours.
MAX_REGENERATIONS_ALLOWED=2

# --- Publish Settings (only checked when META_SIMULATION_MODE=false) ---------
# Set to 1 to create a sponsored ad (in PAUSED status), 0 to skip
MAKE_SPONSORED_PAUSED_AD=1

# Set to 1 to create an organic page post, 0 to skip
MAKE_ORGANIC_POST=1

