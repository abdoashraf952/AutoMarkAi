# ── Shared: Database (PostgreSQL + pgvector) ──────────────────────────────────
# For local dev use localhost; Docker overrides this to "db" via docker-compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automark
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automark
DB_USER=postgres
DB_PASSWORD=postgres

# ── Shared: Gemini API ────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6Ikh4idue3y7UO2q4jqtnIGehaidVo86v8HZWZlohj42Q
GEMINI_MODEL=gemini-2.5-flash

# ── Shared: LangSmith tracing (optional) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=automark-ai

# ── CRM: Gemini models ────────────────────────────────────────────────────────
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── CRM: HubSpot ─────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# ── CRM: Meta Graph API — Messenger ──────────────────────────────────────────
MESSENGER_VERIFY_TOKEN=
MESSENGER_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ID=

# ── CRM: Meta Graph API — Facebook Page Comments ─────────────────────────────
FB_COMMENTS_VERIFY_TOKEN=
FB_COMMENTS_ACCESS_TOKEN=
FB_COMMENTS_APP_SECRET=
FB_COMMENTS_PAGE_ID=

# ── CRM: Vapi Voice ───────────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ── CRM: RAG ─────────────────────────────────────────────────────────────────
RERANKER_BACKEND=gemini
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
KNOWLEDGE_BASE_PATH=./knowledge_base

# ── CRM: Conversation memory ──────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=20
SUMMARIZATION_MESSAGE_THRESHOLD=20

# ── CRM: Application ──────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=False
MAX_AGENT_ITERATIONS=6

# ── Analytics: File uploads ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── Analytics: SQL source limits ─────────────────────────────────────────────
SQL_SOURCE_MAX_ROWS=100000
SQL_SOURCE_TIMEOUT_MS=30000
