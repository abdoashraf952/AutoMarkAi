# ─────────────────────────────────────────────────────────────────────────────
# AutoMark AI CRM Agent (ORCAST) — Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini (google-generativeai) ────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automark

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Get from: HubSpot → Settings → Integrations → Private Apps → Create
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# ── Meta Graph API (Messenger + Facebook Page Comments) ────────────────────
# Get from: https://developers.facebook.com → Your App
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=
FACEBOOK_PAGE_ID=

# ── Vapi Voice ───────────────────────────────────────────────────────────────
# Get from: https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ── LangSmith / LangChain tracing ───────────────────────────────────────────
# Get from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=automark-ai

# ── RAG ──────────────────────────────────────────────────────────────────────
RERANKER_BACKEND=gemini
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
KNOWLEDGE_BASE_PATH=./knowledge_base

# ── Memory ───────────────────────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=20
SUMMARIZATION_MESSAGE_THRESHOLD=20

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=False
MAX_AGENT_ITERATIONS=6
